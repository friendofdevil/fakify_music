<Window x:Class="FakeifyCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fakeify" Height="800" Width="1260" MinHeight="640" MinWidth="1000"
        FontFamily="Segoe UI" FontSize="13" Foreground="#0E3A5C"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>

        <!-- =====================================================================
             PALETTE  (Frutiger Aero: sky blue, aqua, grass green, glossy glass)
             ===================================================================== -->
        <SolidColorBrush x:Key="Ink" Color="#0E3A5C"/>
        <SolidColorBrush x:Key="InkSoft" Color="#3F6E8F"/>
        <SolidColorBrush x:Key="AccentColor" Color="#24A8EA"/>
        <SolidColorBrush x:Key="ToggleOn" Color="#1E9E2E"/>
        <SolidColorBrush x:Key="ToggleOff" Color="#0B6FB8"/>

        <LinearGradientBrush x:Key="SkyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1B8FE3" Offset="0"/>
            <GradientStop Color="#4FC1F3" Offset="0.42"/>
            <GradientStop Color="#8FE6DE" Offset="0.78"/>
            <GradientStop Color="#B6F2A4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0B5FA5" Offset="0"/>
            <GradientStop Color="#13A6D9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glass panels -->
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A6FFFFFF" Offset="0"/>
            <GradientStop Color="#5CFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2FFFFFF" Offset="0"/>
            <GradientStop Color="#70FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlossTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glossy candy fills (hard split at 50% = the classic Aero button look) -->
        <LinearGradientBrush x:Key="BlueFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6CCBFA" Offset="0"/>
            <GradientStop Color="#249CE8" Offset="0.5"/>
            <GradientStop Color="#1280D4" Offset="0.5"/>
            <GradientStop Color="#35B2F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A6EE6B" Offset="0"/>
            <GradientStop Color="#5CCB2E" Offset="0.5"/>
            <GradientStop Color="#3DAE1B" Offset="0.5"/>
            <GradientStop Color="#6FD83F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF9C8A" Offset="0"/>
            <GradientStop Color="#F05A3F" Offset="0.5"/>
            <GradientStop Color="#D63A22" Offset="0.5"/>
            <GradientStop Color="#F26B4E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WhiteGlass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD2EEFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlossButton" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8CFFFFFF" Offset="0"/>
            <GradientStop Color="#26FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlossSmall" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6FFFFFF" Offset="0"/>
            <GradientStop Color="#22FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Rows -->
        <LinearGradientBrush x:Key="RowFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C8FFFFFF" Offset="0"/>
            <GradientStop Color="#78FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RowHoverFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0FFFFFF" Offset="0"/>
            <GradientStop Color="#B4FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RowPlayingFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E3FBCF" Offset="0"/>
            <GradientStop Color="#A9EA85" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2FFFFFF" Offset="0"/>
            <GradientStop Color="#A0FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Slider / progress / scrollbar -->
        <LinearGradientBrush x:Key="TrackFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A0B5C94" Offset="0"/>
            <GradientStop Color="#40FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ScrollThumbFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFB8E6FF" Offset="0"/>
            <GradientStop Color="#FF4FB6EE" Offset="1"/>
        </LinearGradientBrush>

        <!-- Floating bubble -->
        <RadialGradientBrush x:Key="BubbleBrush" GradientOrigin="0.3,0.25" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#B0FFFFFF" Offset="0"/>
            <GradientStop Color="#18FFFFFF" Offset="0.22"/>
            <GradientStop Color="#0CFFFFFF" Offset="0.7"/>
            <GradientStop Color="#70FFFFFF" Offset="0.96"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>

        <!-- Effects -->
        <DropShadowEffect x:Key="SoftShadow" Color="#0A4A7A" Opacity="0.28" BlurRadius="20" ShadowDepth="5" Direction="270"/>
        <DropShadowEffect x:Key="BtnShadow" Color="#06304F" Opacity="0.35" BlurRadius="8" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="FocusGlow" Color="#1FA2EA" Opacity="0.7" BlurRadius="12" ShadowDepth="0"/>
        <DropShadowEffect x:Key="OrbGlow" Color="#3FD21E" Opacity="0.75" BlurRadius="18" ShadowDepth="0"/>

        <!-- =====================================================================
             STYLES
             ===================================================================== -->

        <!-- Icon font text (Segoe Fluent Icons on Win11, Segoe MDL2 Assets on Win10) -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Glass panel: translucent body + curved gloss on the top half -->
        <Style x:Key="GlassPanel" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="20" Background="{StaticResource GlassFill}"
                                    BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.5"
                                    Effect="{StaticResource SoftShadow}"/>
                            <Grid Margin="1.5" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42*"/>
                                    <RowDefinition Height="58*"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="18.5,18.5,0,0" Background="{StaticResource GlossTop}"/>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glossy pill button (blue) -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueFill}"/>
            <Setter Property="BorderBrush" Value="#9908476F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="15" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Effect="{StaticResource BtnShadow}"/>
                            <Border CornerRadius="14" Margin="1" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                            <Grid Margin="2" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="12,12,0,0" Background="{StaticResource GlossButton}"/>
                            </Grid>
                            <Border x:Name="Hover" CornerRadius="15" Background="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#33000000"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{StaticResource GreenFill}"/>
            <Setter Property="BorderBrush" Value="#99236B10"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{StaticResource RedFill}"/>
            <Setter Property="BorderBrush" Value="#99822010"/>
        </Style>

        <!-- Sidebar navigation item -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActiveFill}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CCFFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="drop">
                                <Setter TargetName="Bd" Property="Background" Value="#80A6EE6B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3DAE1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round glass icon button (row actions + transport) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0B6FB8"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{StaticResource WhiteGlass}" Stroke="#8FB9D6" StrokeThickness="1"/>
                            <Grid IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46*"/>
                                    <RowDefinition Height="54*"/>
                                </Grid.RowDefinitions>
                                <Ellipse Margin="3,2,3,0" Fill="{StaticResource GlossSmall}" Grid.RowSpan="1"/>
                            </Grid>
                            <Ellipse x:Name="Hover" Fill="#66A8E4FF" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="#D03A22"/>
        </Style>

        <!-- Big glowing play orb -->
        <Style x:Key="PlayOrb" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GreenFill}"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#99236B10" StrokeThickness="1.2"
                                     Effect="{StaticResource OrbGlow}"/>
                            <Ellipse Margin="1.5" Stroke="#80FFFFFF" StrokeThickness="1"/>
                            <Grid IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46*"/>
                                    <RowDefinition Height="54*"/>
                                </Grid.RowDefinitions>
                                <Ellipse Margin="7,4,7,0" Fill="{StaticResource GlossSmall}"/>
                            </Grid>
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,2,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill text box with placeholder (set the Tag property to the placeholder text) -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
            <Setter Property="SelectionBrush" Value="#5FB8F0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="19" Background="#D4FFFFFF"
                                    BorderBrush="#7FB3D6" BorderThickness="1"/>
                            <Border CornerRadius="18" Margin="1,1,1,0" VerticalAlignment="Top" Height="18"
                                    Background="#55FFFFFF" IsHitTestVisible="False"/>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" Opacity="0.75"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1FA2EA"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource FocusGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider pieces -->
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderFillRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="8" CornerRadius="4" Background="{StaticResource GreenFill}"
                                    BorderBrush="#802A7D12" BorderThickness="1" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrbThumb" TargetType="Thumb">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="{StaticResource WhiteGlass}" Stroke="#8A0B4F7D" StrokeThickness="1"
                                     Effect="{StaticResource BtnShadow}"/>
                            <Ellipse Margin="4" Fill="{StaticResource BlueFill}"/>
                            <Ellipse Margin="5,4,5,0" Height="7" VerticalAlignment="Top" Fill="{StaticResource GlossSmall}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AeroSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="8" CornerRadius="4" Background="{StaticResource TrackFill}"
                                    BorderBrush="#99FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderFillRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource InvisibleRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource OrbThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin glossy progress bar -->
        <Style x:Key="AeroProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="{StaticResource TrackFill}"
                                    BorderBrush="#99FFFFFF" BorderThickness="1"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{StaticResource GreenFill}" BorderBrush="#802A7D12" BorderThickness="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar (vertical) -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="2,0" CornerRadius="5" Background="{StaticResource ScrollThumbFill}"
                                BorderBrush="#99FFFFFF" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border CornerRadius="5" Margin="2,0" Background="#26FFFFFF"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource InvisibleRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource InvisibleRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed popup menu (used by "Add to playlist") -->
        <LinearGradientBrush x:Key="MenuFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FBFFFFFF" Offset="0"/>
            <GradientStop Color="#F0E4F4FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DialogBase" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF4FBFF" Offset="0"/>
            <GradientStop Color="#FFCBE9F9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="AeroMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="11" Background="Transparent"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueFill}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AeroContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10,4,10,14" Padding="6" CornerRadius="16"
                                Background="{StaticResource MenuFill}" BorderBrush="#8FC4E6" BorderThickness="1.5"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Song row: highlights on hover and while playing -->
        <Style x:Key="TrackRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RowFill}"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
            <Setter Property="MinHeight" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverFill}"/>
                    <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                </Trigger>
                <Trigger Property="Tag" Value="playing">
                    <Setter Property="Background" Value="{StaticResource RowPlayingFill}"/>
                    <Setter Property="BorderBrush" Value="#7BCB4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Bubbles drift gently up and down -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="B1T" Storyboard.TargetProperty="Y" From="0" To="-28" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="B2T" Storyboard.TargetProperty="Y" From="0" To="22" Duration="0:0:7.5" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="B3T" Storyboard.TargetProperty="Y" From="0" To="-18" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="B4T" Storyboard.TargetProperty="Y" From="0" To="30" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="B5T" Storyboard.TargetProperty="Y" From="0" To="-24" Duration="0:0:6.5" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- ================= BACKGROUND: sky, light, hills, bubbles ================= -->
        <Grid Background="{StaticResource SkyBrush}" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-380,-560,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7AFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- rolling hills -->
            <Ellipse Height="560" VerticalAlignment="Bottom" Margin="-260,0,-60,-390" Opacity="0.55">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9BE46C" Offset="0"/>
                        <GradientStop Color="#3FAE3C" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Height="520" VerticalAlignment="Bottom" Margin="320,0,-520,-420" Opacity="0.5">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B6F08A" Offset="0"/>
                        <GradientStop Color="#4FBE46" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- bubbles -->
            <Ellipse Width="190" Height="190" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="330,70,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="B1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="120" Height="120" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,120,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="B2T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="80" Height="80" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="90,0,0,170">
                <Ellipse.RenderTransform><TranslateTransform x:Name="B3T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="230" Height="230" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,260,60">
                <Ellipse.RenderTransform><TranslateTransform x:Name="B4T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="60" Height="60" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="B5T"/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ================= APP ================= -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="112"/>
            </Grid.RowDefinitions>

            <!-- 1. Sidebar -->
            <ContentControl Style="{StaticResource GlassPanel}" Grid.Column="0" Grid.Row="0" Margin="0,0,14,14" Padding="14">
                <DockPanel LastChildFill="True">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,18">
                        <Grid Width="42" Height="42">
                            <Ellipse Fill="{StaticResource GreenFill}" Stroke="#99236B10" StrokeThickness="1" Effect="{StaticResource OrbGlow}"/>
                            <Ellipse Margin="6,3,6,0" Height="17" VerticalAlignment="Top" Fill="{StaticResource GlossSmall}"/>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" Foreground="White" FontSize="18"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock Text="Fakeify" FontSize="27" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TitleBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Navigation -->
                    <Button x:Name="BtnLibraryView" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="ShowLocalLibrary_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F1;" Width="28"/>
                            <TextBlock Text="Local Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnQueueView" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="ShowQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Width="28"/>
                            <TextBlock x:Name="LblQueueNav" Text="Queue (0)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock DockPanel.Dock="Top" Text="ADD MUSIC" Foreground="{StaticResource InkSoft}" FontSize="11" FontWeight="Bold" Margin="12,20,0,4"/>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="ImportLocal_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Width="28"/>
                            <TextBlock Text="Import MP4 / MP3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="ImportCSV_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Width="28"/>
                            <TextBlock Text="Import CSV Playlist" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Top" Style="{StaticResource AeroProgress}" Margin="10,12,10,0" Minimum="0" Maximum="100" Value="0"/>

                    <!-- Playlists -->
                    <Grid DockPanel.Dock="Top" Margin="12,20,0,4">
                        <TextBlock Text="PLAYLISTS" Foreground="{StaticResource InkSoft}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New playlist"
                                Width="28" Height="28" HorizontalAlignment="Right" Click="CreatePlaylist_Click"/>
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="Settings_Click" Margin="0,8,0,0" ToolTip="Change where Fakeify saves your music">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Width="28"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <StackPanel x:Name="PlaylistsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </ContentControl>

            <!-- 2. Main content -->
            <ContentControl Style="{StaticResource GlassPanel}" Grid.Column="1" Grid.Row="0" Margin="0,0,0,14" Padding="22,18,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- YouTube search -->
                    <Grid Grid.Row="0" Margin="0,0,6,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtYoutubeSearch" Grid.Column="0" Style="{StaticResource GlassTextBox}"
                                 Tag="Search YouTube and download a song...  (press Enter to play)"
                                 KeyDown="TxtYoutubeSearch_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Height="38" MinWidth="96" Margin="10,0,0,0" Click="SearchPlay_Click" ToolTip="Download and play now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Play" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="38" MinWidth="96" Margin="10,0,0,0" Click="SearchQueue_Click" ToolTip="Download and add to queue">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Queue" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="LblStatus" Grid.Column="3" Text="Ready" Foreground="{StaticResource InkSoft}"
                                   Margin="16,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Header & local filter -->
                    <Grid Grid.Row="1" Margin="0,0,6,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="LblViewHeader" Text="Local Library" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="LblViewCount" Text="" Foreground="{StaticResource InkSoft}" Margin="1,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="TxtLocalFilter" Grid.Column="1" Width="180" Height="34" Margin="0,0,16,0"
                                 Style="{StaticResource GlassTextBox}" Tag="Filter this list..." FontSize="13"
                                 TextChanged="LocalFilter_TextChanged"/>
                        <StackPanel x:Name="HeaderActionPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Track list -->
                    <ScrollViewer x:Name="TrackScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" AllowDrop="True"
                                  PreviewDragOver="TrackList_PreviewDragOver" DragOver="TrackList_DragOver" Drop="TrackList_Drop">
                        <ItemsControl x:Name="TrackListItems"/>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <!-- 3. Player bar -->
            <ContentControl Style="{StaticResource GlassPanel}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Now playing -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Border CornerRadius="15" Background="{StaticResource BlueFill}" BorderBrush="#9908476F" BorderThickness="1"
                                    Effect="{StaticResource BtnShadow}"/>
                            <Border CornerRadius="14" Margin="1" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                            <Border CornerRadius="13,13,0,0" Margin="3,3,3,0" Height="24" VerticalAlignment="Top" Background="{StaticResource GlossButton}"/>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" Foreground="White" FontSize="22" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LblNowPlaying" Text="Nothing playing" FontWeight="Bold" FontSize="14"
                                       MaxWidth="205" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                            <TextBlock x:Name="LblNowSub" Text="Pick a song to begin" Foreground="{StaticResource InkSoft}"
                                       MaxWidth="205" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Transport + seek bar -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <Button x:Name="BtnShuffle" Style="{StaticResource IconButton}" Content="&#xE8B1;" ToolTip="Shuffle"
                                    Width="36" Height="36" Margin="4,0" Click="ToggleShuffle_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (Ctrl+Left)"
                                    Width="42" Height="42" FontSize="16" Margin="6,0" Click="PrevAudio_Click"/>
                            <Button x:Name="BtnPlayPause" Style="{StaticResource PlayOrb}" Content="&#xE768;" ToolTip="Play / Pause (Space)"
                                    Margin="8,0" Click="TogglePlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (Ctrl+Right)"
                                    Width="42" Height="42" FontSize="16" Margin="6,0" Click="SkipAudio_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop"
                                    Width="36" Height="36" Margin="4,0" Click="StopAudio_Click"/>
                            <Button x:Name="BtnRepeat" Style="{StaticResource IconButton}" Content="&#xE8ED;" ToolTip="Repeat current song"
                                    Width="36" Height="36" Margin="4,0" Click="ToggleRepeat_Click"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblCurrentTime" Grid.Column="0" Text="00:00" Foreground="{StaticResource InkSoft}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource AeroSlider}" Minimum="0" Maximum="100" Margin="10,0"
                                    Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted"
                                    ValueChanged="ProgressSlider_ValueChanged"/>
                            <TextBlock x:Name="LblTotalTime" Grid.Column="2" Text="00:00" Foreground="{StaticResource InkSoft}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMute" Style="{StaticResource IconButton}" Content="&#xE995;" ToolTip="Mute (M)"
                                Width="34" Height="34" Margin="0,0,10,0" Click="ToggleMute_Click"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource AeroSlider}" Width="130" Minimum="0" Maximum="1" Value="0.7"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ================= DIALOG HOST (themed replacement for MessageBox / InputBox) ================= -->
        <Grid x:Name="DialogHost" Visibility="Collapsed">
            <Border Background="#8C062B4A"/>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Margin="24">
                <Border CornerRadius="22" Background="{StaticResource DialogBase}" Effect="{StaticResource SoftShadow}"/>
                <ContentControl Style="{StaticResource GlassPanel}" Padding="28,24,28,22">
                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer x:Name="DialogMessageScroll" MaxHeight="300" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{StaticResource InkSoft}"/>
                        </ScrollViewer>
                        <ContentControl x:Name="DialogExtra"/>
                        <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ================= LOADING OVERLAY ================= -->
        <Border x:Name="LoadingOverlay" Background="{StaticResource SkyBrush}">
            <Grid ClipToBounds="True">
                <Ellipse Width="260" Height="260" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,90,0,0"/>
                <Ellipse Width="150" Height="150" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,120"/>
                <Ellipse Width="90" Height="90" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,260,0"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="110" Height="110" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource GreenFill}" Stroke="#99236B10" StrokeThickness="1.5" Effect="{StaticResource OrbGlow}"/>
                        <Ellipse Margin="2" Stroke="#80FFFFFF" StrokeThickness="1.2"/>
                        <Ellipse Margin="14,7,14,0" Height="46" VerticalAlignment="Top" Fill="{StaticResource GlossSmall}"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" Foreground="White" FontSize="46" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                    <TextBlock Text="Fakeify" Foreground="White" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#06406E" BlurRadius="10" ShadowDepth="2" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="LblLoadingStatus" Text="Initializing application..." Foreground="White" FontSize="14"
                               Margin="0,8,0,22" HorizontalAlignment="Center"/>
                    <Border Width="300" Height="10" CornerRadius="5" Background="{StaticResource TrackFill}"
                            BorderBrush="#99FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadChunkT" Storyboard.TargetProperty="X"
                                                         From="-110" To="310" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border Width="110" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource GreenFill}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LoadChunkT" X="-110"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
